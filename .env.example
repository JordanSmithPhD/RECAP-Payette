# Optional alternatives to config.yaml. Never commit real local paths or secrets.
RECAP_PAYETTE_CONFIG=config.yaml
RECAP_PAYETTE_DATA_ROOT=data
RECAP_PAYETTE_OUTPUT_ROOT=outputs
RECAP_PAYETTE_CAMERA_ROOT=data/external_camera_archive
RECAP_PAYETTE_TRAINING_ROOT=data/external_training
RECAP_PAYETTE_PARKING_RUN_ID=recommended_v1

# Google Earth Engine identifies a Cloud project; authentication remains in
# the Earth Engine CLI's user-local credential store.
GEE_PROJECT_ID=replace-with-your-cloud-project-id
